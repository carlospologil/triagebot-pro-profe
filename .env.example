# Copia este fichero a .env y ajusta los valores. No subas .env al repositorio.
# La aplicación lee solo variables de entorno: expórtalas antes de arrancar
# (por ejemplo: `set -a; source .env; set +a`).

# OBLIGATORIA. Clave para firmar las cookies de sesión. Usa una cadena larga y aleatoria,
# por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Ruta del fichero SQLite. Opcional; por defecto: triagebot.db
DATABASE_PATH=triagebot.db

# Clave de OpenRouter para la clasificación con IA (modelo openai/gpt-oss-120b).
# Opcional para arrancar la aplicación; necesaria para clasificar tickets.
OPENROUTER_API_KEY=
